@SlotSize = 80;
@Padding = 5;

Group #FuelPanel{
    LayoutMode: MiddleCenter;
    FlexWeight: 1.0;

    ItemGrid #FuelItemGrid {
        RenderItemQualityBackground: true;
        AreItemsDraggable: true;
        SlotsPerRow: 1;
        InventorySectionId: 2;
        Style: (
            SlotSize: @SlotSize,
            SlotIconSize: @SlotSize,
            SlotSpacing: @Padding,
            SlotBackground: "InputBox2x.png"
        );
    }
}